# Local development — SQLite. In production, set DATABASE_URL to a postgres:// URL
# (see prisma.config.ts, which picks the schema/provider based on this value).
DATABASE_URL="file:./prisma/dev.db"

# Family password gate (§1) — required once per browser, remembered via a long-lived cookie.
FAMILY_PASSWORD=""

# Parent Mode passcode (§2) — required to enter Parent Mode.
PARENT_PASSCODE=""

# Secret used to sign session cookies. Generate your own with:
#   openssl rand -base64 32
SESSION_SECRET=""

# Optional, local dev only (ignored in production regardless of value):
# pins "today" to a fixed date so Student Mode's interactive column and
# check/uncheck can be tested on any weekday without waiting for it or
# changing the Mac's clock. Uncomment and set to a YYYY-MM-DD weekday, e.g.:
# DEBUG_TODAY="2026-08-11"
