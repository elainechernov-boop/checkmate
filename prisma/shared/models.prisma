// Shared model definitions for both the sqlite (dev) and postgresql (prod) schemas.
// See prisma/sqlite and prisma/postgresql for the datasource each is paired with,
// and prisma.config.ts for how the active one is selected via DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

// ---- Enums ----

enum WorkSampleCategory {
  math
  languageArts
  science
  socialStudies
  none
}

enum ProjectStatus {
  active
  completed
  archived
}

enum CreatedBy {
  parent
  student
}

enum Frequency {
  daily
  weekdays
  weekly
  biweekly
  monthly
}

enum EndCondition {
  never
  onDate
  afterNCount
}

enum InstanceStatus {
  open
  pendingReview
  done
  excused
}

enum SchoolDayType {
  schoolDay
  offDay
  fieldTrip
  sick
  holiday
}

// ---- Models (SPEC.md §3) ----

// A tenant — one homeschooling family (see MULTI_FAMILY_SPEC.md). Every
// family-owned model below carries a familyId so many families can share
// one deployment and one database without seeing each other's data. Each
// familyId field defaults to "seed-family" — the one row this migration
// seeds for the existing production family — purely so every existing
// create call across the app keeps compiling and working unchanged; that
// default is removed once real per-family login and scoping lands, at
// which point every write starts passing its own family's id explicitly.
model Family {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  plan      String   @default("beta")

  // Hashed at rest (session.ts's hashSecret/secretMatchesHash) — nullable
  // because the seed family's row is created by migration before any code
  // runs, so it starts empty and self-heals to a hash on that family's
  // first post-migration login, falling back to the legacy FAMILY_PASSWORD/
  // PARENT_PASSCODE env vars in the meantime (gate/actions.ts,
  // parent/unlock/actions.ts). Every family created after Phase 2 (via the
  // admin tool in Phase 4) gets both hashes set at creation time.
  accessCodeHash     String?
  parentPasscodeHash String?

  // Attendance/work-sample-category/learning-periods/the HST report were
  // all built for one specific charter-school program's requirements
  // (MULTI_FAMILY_SPEC.md Phase 3) — off by default for a new family, since
  // most homeschool co-ops don't report to Blue Ridge Academy specifically.
  complianceModuleEnabled Boolean @default(false)

  students                 Student[]
  subjects                 Subject[]
  projects                 Project[]
  projectIdeas             ProjectIdea[]
  assignmentSeries         AssignmentSeries[]
  assignmentInstances      AssignmentInstance[]
  schoolDays               SchoolDay[]
  learningPeriods          LearningPeriod[]
  daySeparators            DaySeparator[]
  familyCalendarSettings   FamilyCalendarSettings[]
  dismissedCalendarEvents  DismissedCalendarEvent[]
  calendarEventAssignments CalendarEventAssignment[]
  undoLogEntries           UndoLogEntry[]
}

model Student {
  id          String  @id @default(cuid())
  familyId    String  @default("seed-family")
  family      Family  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  name        String
  gradeLevel  String
  accentColor String

  projects            Project[]
  projectIdeas        ProjectIdea[]
  assignmentSeries    AssignmentSeries[]
  assignmentInstances AssignmentInstance[]
  schoolDays          SchoolDay[]
  daySeparators       DaySeparator[]

  @@unique([familyId, name])
}

model Subject {
  id                 String             @id @default(cuid())
  familyId           String             @default("seed-family")
  family             Family             @relation(fields: [familyId], references: [id], onDelete: Restrict)
  name               String
  workSampleCategory WorkSampleCategory @default(none)
  isFaithIntegrated  Boolean            @default(false)

  projects            Project[]
  assignmentSeries    AssignmentSeries[]
  assignmentInstances AssignmentInstance[]

  @@unique([familyId, name])
}

model Project {
  id         String        @id @default(cuid())
  familyId   String        @default("seed-family")
  family     Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  name       String
  targetDate DateTime?
  subjectId  String?
  subject    Subject?      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  status     ProjectStatus @default(active)
  // §7 "prioritized" — the student's own drag-order for the Projects band,
  // same convention as AssignmentInstance.sortOrder (ties break on
  // createdAt, so untouched projects keep their creation order).
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  series    AssignmentSeries[]
  instances AssignmentInstance[]

  @@index([familyId])
  @@index([studentId])
}

// A student-kept "someday" scratch list, one level lighter than Project
// itself (§7) — a bare line of text, nothing to schedule or track, until the
// student decides to promote one into a real Project (moving it out of this
// list and into the band above as a fresh Project with the idea's text as
// its name — see projects.ts's promoteProjectIdea).
model ProjectIdea {
  id        String   @id @default(cuid())
  familyId  String   @default("seed-family")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  text      String
  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([studentId])
}

// The template a day's instances are materialized from (§3 materialization rule).
model AssignmentSeries {
  id        String  @id @default(cuid())
  familyId  String  @default("seed-family")
  family    Family  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  title     String
  details   String?
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // nil for a student project series
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy CreatedBy

  recurrence RecurrenceRule?

  startDate    DateTime
  endCondition EndCondition @default(never)
  // used when endCondition = onDate
  endDate      DateTime?
  // used when endCondition = afterNCount
  endCount     Int?

  estimatedMinutes Int?
  // "Show me the work" — a completed instance needs parent sign-off (§5)
  requiresReview   Boolean @default(false)

  // §12: a fixed clock time (an online class, a co-op meeting) — pins the
  // materialized instance to the top of its day and drives the reminder
  // popup. scheduledTime is "HH:MM" 24-hour local wall-clock time (no
  // timezone modeled, matching dueDate's own plain-calendar-date treatment).
  isTimeSensitive       Boolean @default(false)
  scheduledTime         String?
  reminderMinutesBefore Int?

  instances          AssignmentInstance[]
  removedOccurrences RemovedOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([studentId])
}

// A series occurrence deleted via "this assignment only" (§4/§5) — the
// negative-space counterpart to an AssignmentInstance row. materializeSeries
// only ever skips creating an occurrence it can see an existing instance
// for; a hard delete alone leaves that date looking exactly like one that
// was simply never generated yet, so the next materialization pass would
// otherwise recreate it as a fresh open instance. Recording the date here
// (keyed the same way as AssignmentInstance.originalDueDate) tells
// materializeSeries to permanently skip it instead, the same way a capped
// series endDate already does for "this and following" deletes.
model RemovedOccurrence {
  id       String           @id @default(cuid())
  seriesId String
  series   AssignmentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  date     DateTime

  @@unique([seriesId, date])
  @@index([seriesId])
}

model RecurrenceRule {
  id       String           @id @default(cuid())
  seriesId String           @unique
  series   AssignmentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  frequency Frequency
  // Comma-separated Weekday codes (e.g. "tue,thu") for weekly/biweekly frequencies.
  // Stored as a CSV string, not a scalar list, so this field works identically on
  // sqlite (no native scalar-list support) and postgresql.
  daysOfWeek String?
  // every N weeks/months
  interval   Int    @default(1)
}

// What actually appears on a day — materialized from a series, or standalone (§3).
model AssignmentInstance {
  id        String            @id @default(cuid())
  familyId  String            @default("seed-family")
  family    Family            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  seriesId  String?
  series    AssignmentSeries? @relation(fields: [seriesId], references: [id])
  title     String
  details   String?
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subjectId String?
  subject   Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  projectId String?
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy CreatedBy

  // nil dueDate is a project backlog item (student-created project tasks only)
  dueDate         DateTime?
  // set on scheduling; diverges from dueDate once the item rolls
  originalDueDate DateTime?
  rolledCount     Int            @default(0)
  status          InstanceStatus @default(open)
  // copied from series; settable per one-off
  requiresReview  Boolean        @default(false)
  // §12: copied from series (same pattern as requiresReview above), settable
  // per one-off / per-instance override.
  isTimeSensitive       Boolean @default(false)
  scheduledTime         String?
  reminderMinutesBefore Int?
  // Copied from series, same pattern — without this, a standalone instance
  // (no series) or a "this assignment only" edit had nowhere to persist an
  // estimated-minutes change at all (a real bug: Save silently did nothing).
  estimatedMinutes Int?
  completedAt     DateTime?
  // the later of completedAt/reviewedAt feeds the attendance log
  reviewedAt      DateTime?
  isWorkSample    Boolean        @default(false)
  workSampleNote  String?
  // set when the parent returns a "Show Mom" item ("not your best work");
  // shown beneath the title until the student completes it again (§5)
  returnNote      String?
  // a per-instance edit detaches it from the series for this occurrence only
  isOverride      Boolean        @default(false)
  // manual same-day ordering within the "open" bucket (student drag-reorder,
  // today only); ties break on createdAt
  sortOrder       Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([studentId, dueDate])
  @@index([seriesId])
}

// The school calendar (§3, §8)
// Per-student (§5's field trips/off/sick days and §8's attendance are both
// tracked per kid) — the family-wide academic calendar (§8 "import Blue
// Ridge's calendar once") is just every student getting the same date+type
// written at once, not a separate shared row, so every read here is a
// plain per-student lookup with no null-studentId fallback to special-case.
model SchoolDay {
  id                String        @id @default(cuid())
  familyId          String        @default("seed-family")
  family            Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  date              DateTime
  studentId         String
  student           Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  type              SchoolDayType @default(schoolDay)
  attendanceClaimed Boolean       @default(false)
  activityNote      String?

  @@unique([date, studentId])
  @@index([familyId])
  @@index([studentId])
}

model LearningPeriod {
  id             String    @id @default(cuid())
  familyId       String    @default("seed-family")
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  name           String
  startDate      DateTime
  endDate        DateTime
  hstMeetingDate DateTime?

  @@index([familyId])
}

// A capped undo log for Parent Mode's most destructive actions — deleting a
// single assignment, and marking a day/range off (or back on). Each entry
// snapshots exactly what's needed to restore the affected rows; undoing
// marks the entry used rather than deleting it, so the log stays a
// readable recent-activity trail (last 10-20 steps) even after something's
// been undone. No FK relations on purpose — a snapshot has to survive even
// if the rows it references are gone by the time someone tries to undo it.
model UndoLogEntry {
  id         String    @id @default(cuid())
  familyId   String    @default("seed-family")
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  actionType String
  summary    String
  payload    String
  createdAt  DateTime  @default(now())
  undoneAt   DateTime?

  @@index([familyId])
  @@index([createdAt])
}

// A parent-placed divider within one day's column (§6) — "Morning,"
// "Afternoon," "Evening," or any free-text label the parent types ("Before
// breakfast"). Shares the same sortOrder numbering space as that day's
// AssignmentInstance rows (see reorderInstances.ts) so the two can be
// interleaved into one ordered list. Parent-only to create, move, or
// delete; students see them but can only reorder their own open items
// *within* the segment a separator bounds, never across one.
model DaySeparator {
  id        String   @id @default(cuid())
  familyId  String   @default("seed-family")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  date      DateTime
  label     String
  sortOrder Int      @default(0)

  @@index([familyId])
  @@index([studentId, date])
}

// The family's Google Calendar, imported read-only into Parent Mode's week
// view via its "Secret address in iCal format" (Calendar → Settings →
// that calendar → Integrate calendar) — a plain unauthenticated feed URL,
// no OAuth needed since nothing is ever written back. Singleton: at most
// one row ever exists. timeZone is the IANA name events are bucketed into
// a calendar day by (an ICS instant is timezone-agnostic; "which day it
// shows up on" isn't, and this app models no other timezone anywhere).
model FamilyCalendarSettings {
  id        String   @id @default(cuid())
  familyId  String   @default("seed-family")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  icsUrl    String
  timeZone  String   @default("America/Los_Angeles")
  updatedAt DateTime @updatedAt

  @@unique([familyId])
}

// A calendar event the parent has dismissed from Parent Mode's overlay
// (ParentWeekBoard's CalendarEventRow hover-X) — since the feed itself is
// read-only (FamilyCalendarSettings), "deleting" one can only ever mean
// "stop showing me this occurrence," recorded here so it stays hidden
// across reloads instead of reappearing the next time the ICS is re-fetched.
// eventKey matches FamilyCalendarEvent.id (`${uid}-${start.toISOString()}`)
// — one specific occurrence, not the whole recurring series, so dismissing
// today's standing meeting doesn't hide next week's.
model DismissedCalendarEvent {
  id        String   @id @default(cuid())
  familyId  String   @default("seed-family")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  eventKey  String   @unique
  createdAt DateTime @default(now())

  @@index([familyId])
}

// The redesign's durable "this calendar event belongs to this student"
// relation (design_handoff_homeroom_redesign/README.md's shared-agenda
// drag-or-tap-to-assign) — replaces the old one-way "convert to a real
// to-do" action entirely. An assigned event stays a calendar event (never
// becomes an AssignmentInstance): it disappears from the shared agenda and
// renders under that student's board instead, marking itself done once its
// own end time passes rather than being checked off. Same upsert-on-
// conflict shape as DismissedCalendarEvent; one event can be assigned to
// more than one student (a family outing both kids attend), so the unique
// key is the pair, not eventKey alone.
model CalendarEventAssignment {
  id        String   @id @default(cuid())
  familyId  String   @default("seed-family")
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  eventKey  String
  studentId String
  createdAt DateTime @default(now())

  @@unique([eventKey, studentId])
  @@index([familyId])
  @@index([eventKey])
}
